.metadata/
*.cache/
*.data/
*.ipdefs/
*.sdk/
*.hw/
*.ip_user_files/
*.runs/
*.gen/
*.sim/
.jobs/
*_synth_*/

# Exported release/package output.
export/

# Vivado block-design/IP generated output products.
# Keep design intent files such as *.bd, HDL sources, and constraints.
SourceData/BlockDesign/**/.Xil/
SourceData/BlockDesign/**/ip/
SourceData/BlockDesign/**/ipshared/
SourceData/BlockDesign/**/sim/
SourceData/BlockDesign/**/synth/
SourceData/BlockDesign/**/hw_handoff/
SourceData/BlockDesign/**/ip/**/bd_*/
SourceData/BlockDesign/**/ip/**/hdl/
SourceData/BlockDesign/**/ip/**/sim_tlm/
SourceData/BlockDesign/**/ip/**/*.c
SourceData/BlockDesign/**/ip/**/*.h
SourceData/BlockDesign/**/ip/**/*.html
SourceData/BlockDesign/**/ip/**/*.tcl
SourceData/BlockDesign/**/ip/**/*.xdc
SourceData/BlockDesign/**/*.bda
SourceData/BlockDesign/**/*.bxml
SourceData/BlockDesign/**/*.dcp
SourceData/BlockDesign/**/*.hwdef
SourceData/BlockDesign/**/*.hwh
SourceData/BlockDesign/**/*.mem
SourceData/BlockDesign/**/*.protoinst
SourceData/BlockDesign/**/*.ui
SourceData/BlockDesign/**/*.xml
SourceData/BlockDesign/**/*.veo
SourceData/BlockDesign/**/*.vho
SourceData/BlockDesign/**/*_board.xdc
SourceData/BlockDesign/**/*_ooc.xdc

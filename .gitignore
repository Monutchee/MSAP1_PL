.Xil/
*.jou
*.log
*.debug
*.str
*.tmp
*.rst
*.os
*.pb
*.vds
*.wdf
*.vdi
*.dmp
*.rpx
*.rpt
*.backup.jou
*.backup.log
*_funcsim.v
*_funcsim.vhdl
.project

